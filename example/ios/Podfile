# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AppsOnAirPushExample' do
  config = use_native_modules!

  # Optional: build against a local iOS SDK checkout with
  #   APPSONAIR_LOCAL_SDK=1 npm run pods:new
  if ENV['APPSONAIR_LOCAL_SDK'] == '1'
    Pod::UI.puts 'AppsOnAir: using the local iOS SDK checkout'.yellow
    pod 'AppsOnAir-AppPush', :path => '../../../appsonair-ios-push-notification'
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AppsOnAirPushExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # The app target has no Swift files, so Xcode doesn't add the Swift runtime
    # search paths and linking the Swift pods fails on the Old Architecture
    # (`__swift_FORCE_LOAD_$_swiftCompatibility56`). An empty .swift file in the
    # app target fixes it too.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['LIBRARY_SEARCH_PATHS'] = [
            '$(inherited)',
            # DT_TOOLCHAIN_DIR: TOOLCHAIN_DIR points at the Metal toolchain in Xcode 26.
            '$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)',
            '/usr/lib/swift'
          ]
        end
      end
      aggregate_target.user_project.save
    end
  end
end

target 'AppsonairNotificationServiceExtension' do
  pod 'AppsOnAir-AppPush/ServiceExtension', '1.0.5-beta'
end
